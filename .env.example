# Mqulima Database Configuration
DATABASE_URL=postgresql://mqulima:password@localhost:5432/mqulima_dev

# JWT Authentication Secret (Generate a 256-bit secret)
JWT_SECRET=your_jwt_secret_here

# Public App URL
VITE_APP_URL=http://localhost:3000

# Gemini API Configuration (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# M-Pesa Daraja API Configuration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox

# TextSMS Kenya Bulk SMS API Configuration
TEXTSMS_PARTNER_ID=16948
TEXTSMS_API_KEY=your_textsms_api_key_here
TEXTSMS_SENDER_ID=KIRGIT_AGRI
TEXTSMS_API_URL=https://sms.textsms.co.ke/api/services/sendsms/
TEXTSMS_MOCK_MODE=true
