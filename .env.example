# Mqulima Database Configuration
DATABASE_URL=postgresql://mqulima:password@localhost:5432/mqulima_dev

# JWT Authentication Secret (Generate a 256-bit secret)
JWT_SECRET=your_jwt_secret_here

# Public App URL
VITE_APP_URL=http://localhost:3000

# Gemini API Configuration (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# M-Pesa Daraja API Configuration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
MPESA_WEBHOOK_SECRET=your_mpesa_webhook_secret_here

# TextSMS Kenya Bulk SMS API Configuration
TEXTSMS_PARTNER_ID=your_textsms_partner_id
TEXTSMS_API_KEY=your_textsms_api_key_here
TEXTSMS_SENDER_ID=your_textsms_sender_id
TEXTSMS_API_URL=https://sms.textsms.co.ke/api/services/sendsms/
TEXTSMS_MOCK_MODE=true

# Africa's Talking SMS API Configuration (Optional/Alternative Provider)
AT_API_KEY=your_africas_talking_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=your_at_sender_id_if_provisioned

# Upstash Redis Configuration (Distributed Rate Limiting for Login & Recovery)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# NCBA Bank STK Push API Configuration
NCBA_ENVIRONMENT=sandbox
NCBA_BASE_URL=https://api.ncbagroup.com
NCBA_CLIENT_ID=your_ncba_client_id_here
NCBA_CLIENT_SECRET=your_ncba_client_secret_here
NCBA_API_KEY=your_ncba_api_key_if_applicable
NCBA_MERCHANT_ID=your_ncba_merchant_id_here
NCBA_SHORTCODE=your_ncba_shortcode_here
NCBA_PASSKEY=your_ncba_passkey_here
NCBA_CALLBACK_URL=https://your-domain.com/api/payments/ncba/callback
NCBA_WEBHOOK_SECRET=your_ncba_webhook_secret_here
NCBA_SECRET_KEY=your_ncba_secret_key_here
NCBA_CALLBACK_USERNAME=your_ncba_callback_username
NCBA_CALLBACK_PASSWORD=your_ncba_callback_password

# Paystack Card Payment Integration (Test / Production)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_CALLBACK_URL=https://your-domain.com/payments/paystack/callback
PAYSTACK_WEBHOOK_URL=https://your-domain.com/api/payments/paystack/webhook
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# POS & External Integration Tokens
POS_SYNC_TOKEN=your_pos_sync_token_here
WOO_CONSUMER_KEY=your_woo_consumer_key_here
WOO_CONSUMER_SECRET=your_woo_consumer_secret_here

# Smooth Sale POS Integration Configuration
SMOOTH_SALE_BASE_URL=https://technolake.net/smooth-sale-pos/public
SMOOTH_SALE_CLIENT_ID=your_smooth_sale_client_id
SMOOTH_SALE_CLIENT_SECRET=your_smooth_sale_client_secret_here
SMOOTH_SALE_USERNAME=your_smooth_sale_username
SMOOTH_SALE_PASSWORD=your_smooth_sale_password_here

# S3 / Cloudflare R2 Media Storage Configuration
S3_BUCKET=mqulima-media
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
CDN_PUBLIC_URL=https://cdn.mqulima.com

# -----------------------------------------------------------------------------
# Google Analytics 4 (GA4) Client-Side Tracking & Microsoft Clarity
# -----------------------------------------------------------------------------
# Public GA4 Measurement ID (Production Web Stream: Mqulima Website - Stream ID: 16122564617)
# Used by the web client with Google Consent Mode v2 & TanStack Router client navigation
VITE_GA_MEASUREMENT_ID=G-G1QQTG8YJT
# Set to true to test live GA4 hits from localhost (otherwise logs in simulation mode to avoid polluting prod data)
VITE_ENABLE_DEV_ANALYTICS=false

# Optional: Microsoft Clarity Project ID for consent-governed session replay
VITE_CLARITY_PROJECT_ID=your_clarity_project_id_here

# -----------------------------------------------------------------------------
# Google Analytics Data API (Server-Side Admin Reporting at /admin/analytics)
# -----------------------------------------------------------------------------
# Numeric GA4 Property ID (found in GA4 Admin -> Property Settings -> Property Details)
GA4_PROPERTY_ID=123456789

# Google Cloud Service Account Authentication (Choose ONE of the three options):
# Option A: Path to local service account JSON key file (Standard for local development)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/ga4-service-account-key.json

# Option B: Direct credentials (Standard for Vercel / containerized cloud deployments)
GOOGLE_SERVICE_ACCOUNT_EMAIL=mqulima-analytics@your-gcp-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option C: Base64-encoded full service account JSON key (Alternative for single-variable Vercel setup)
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIs...

