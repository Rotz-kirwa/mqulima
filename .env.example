# Mqulima Enterprise Environment Variables Configuration
# Copy this file to .env and populate with production secrets

# ----------------------------------------------------
# Core Environment & Security Secrets
# ----------------------------------------------------
NODE_ENV=development
# PostgreSQL Database Connection String
DATABASE_URL=postgresql://mqulima:your_password@localhost:5432/mqulima_dev

# JWT Authentication Secret (Minimum 16 characters; generate: openssl rand -hex 32)
JWT_SECRET=mqulima-jwt-secret-key-production-2026-secure
SESSION_SECRET=mqulima-session-secret-key-production-2026-secure

# CSRF Development Bypass Flag (MUST BE FALSE OR UNSET IN PRODUCTION)
ALLOW_DEV_CSRF_BYPASS=false

# ----------------------------------------------------
# Redis Infrastructure (Sliding-Window Rate Limiting)
# ----------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ----------------------------------------------------
# Artificial Intelligence Subsystem
# ----------------------------------------------------
# Google Gemini 3.5 Flash API Key (Google AI Studio)
GEMINI_API_KEY=your_google_gemini_api_key_here

# ----------------------------------------------------
# Safaricom M-Pesa Daraja 2.0 API & Webhooks
# ----------------------------------------------------
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
MPESA_WEBHOOK_SECRET=your_mpesa_webhook_secret_here

# ----------------------------------------------------
# Public Client & Domain Configuration
# ----------------------------------------------------
VITE_APP_URL=http://localhost:3000
MAIN_APP_URL=http://localhost:8080

